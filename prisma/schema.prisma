generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String  @id @default(uuid())
  organizationProfilePic String? @db.LongText
  organizationName       String
  organizationOwnerName  String
  organizationCode       String  @unique

  address   String?
  wifiSSID  String?
  wifiBSSID String?

  inTime  String?
  outTime String?

  latitude  Float    @default(0)
  longitude Float    @default(0)
  radius    Float?
  createdAt DateTime @default(now())

  // MySQL doesn't support scalar arrays, use Json
  workingDays Json?

  employeeCount Int @default(0)

  // Super Organization Hierarchy
  parentId String?
  parent   Organization?  @relation("SuperOrgHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("SuperOrgHierarchy")

  employees     Employee[]
  notifications Notification[]
  shifts        Shift[]
  adminRoles    AdminRole[]
}

model Employee {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeName     String
  employeeEmail    String       @unique
  password         String
  profilePic       String? @db.LongText
  organizationCode String?
  role             Role         @default(Employee)
  isVerified       Boolean      @default(false)
  otp              String?
  otpExpires       DateTime?
  status           Status       @default(active)
  lastLogin        DateTime?

  attendances     Attendance[]
  leaves          Leave[]
  notifications   Notification[]
  devices         EmployeeDevice[]
  regularizations AttendanceRegularization[]

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  history EmploymentHistory[]

  @@index([organizationCode])
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  startTime      String
  endTime        String
  weekOffs       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]
}

model EmployeeDevice {
  id             String       @id @default(uuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uuid           String       @unique
  model          String?
  manufacturer   String?
  androidVersion String?
  appVersion     String?
  firebaseToken  String?
  status         DeviceStatus @default(ACTIVE)
  registeredDate DateTime     @default(now())
}

model Attendance {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  employeeName     String
  organizationCode String
  date             DateTime
  wifiSSID         String?
  wifiBSSID        String?
  deviceId         String?
  ipAddress        String?
  latitude         Float?
  longitude        Float?

  sessions Session[]

  totalHours       Float    @default(0)
  extraHours       Float    @default(0)
  finalRemark      String   @default("Absent")
  regularized      Boolean  @default(false)
  regularizationId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([employeeId, date])
  @@index([organizationCode, date])
}

model Session {
  id             String     @id @default(uuid())
  attendanceId   String
  attendance     Attendance @relation(fields: [attendanceId], references: [id])
  clockInTime    DateTime
  clockOutTime   DateTime?
  duration       Float      @default(0)
  clockInRemark  String?
  clockOutRemark String?

  @@index([attendanceId])
}

model Leave {
  id               String      @id @default(uuid())
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id])
  employeeName     String
  organizationCode String
  leaveType        LeaveType
  startDate        DateTime
  endDate          DateTime
  status           LeaveStatus @default(Pending)
  reason           String?
  createdAt        DateTime    @default(now())

  @@index([employeeId, startDate, endDate])
  @@index([organizationCode, startDate, endDate])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           Employee         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  message        String
  type           NotificationType
  createdAt      DateTime         @default(now())
  isRead         Boolean          @default(false)
  target         TargetType
}

enum Role {
  Employee
  Manager
  Admin
}

enum Status {
  active
  inactive
}

enum LeaveType {
  Sick_Leave     @map("Sick Leave")
  Vacation_Leave @map("Vacation Leave")
  Paid_Leave     @map("Paid Leave")
  Unpaid_Leave   @map("Unpaid Leave")
  Work_From_Home @map("Work From Home")
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
}

enum NotificationType {
  Reminder
  LeaveApproval
  Absent
  ClockIn
  ClockOut
  Join
}

enum TargetType {
  Employee
  Organization
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

model AttendanceRegularization {
  id                String               @id @default(uuid())
  employeeId        String
  employee          Employee             @relation(fields: [employeeId], references: [id])
  organizationCode  String
  attendanceDate    DateTime
  requestType       String // e.g. "Missing Check-In", "Missing Check-Out", "System Error"
  requestedCheckIn  String? // e.g. "09:00"
  requestedCheckOut String? // e.g. "18:00"
  reason            String
  attachment        String? @db.LongText // Base64 data
  status            RegularizationStatus @default(Pending)
  adminRemark       String?
  approvedBy        String? // Admin/Manager ID or name
  approvedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([employeeId, attendanceDate])
  @@index([organizationCode, status])
}

enum RegularizationStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

model EmploymentHistory {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationCode String
  status           String    @default("inactive")
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
}

model Admin {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  isVerified Boolean   @default(false)
  otp        String?
  otpExpires DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roles AdminRole[]
}

enum AdminRoleType {
  ADMIN
  SUPER_ADMIN
}

model AdminRole {
  id             String        @id @default(uuid())
  adminId        String
  admin          Admin         @relation(fields: [adminId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  role           AdminRoleType @default(ADMIN)
  createdAt      DateTime      @default(now())

  @@index([adminId])
  @@index([organizationId])
}
